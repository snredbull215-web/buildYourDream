<view class="page dashboard">
  <view class="hero">
    <image class="hero-bg" src="/assets/home-hero-dollar.jpg" mode="aspectFill"></image>
    <view class="hero-shade"></view>
    <view class="hero-content">
      <view class="hero-logo-row">
        <image class="hero-logo" src="/assets/app-icon-dollar-small.png" mode="aspectFill"></image>
        <view>
          <view class="hero-name">天天记账</view>
          <view class="hero-date">{{todayLabel}}</view>
        </view>
      </view>
      <view class="hero-caption">本月结余</view>
      <view class="hero-balance">¥{{heroSummary.balanceText}}</view>
      <view class="summary-grid">
        <view>
          <view class="hero-caption">本月收入</view>
          <view class="summary-value amount-income">¥{{heroSummary.incomeText}}</view>
        </view>
        <view>
          <view class="hero-caption">本月支出</view>
          <view class="summary-value amount-expense">¥{{heroSummary.expenseText}}</view>
        </view>
        <view>
          <view class="hero-caption">预算剩余</view>
          <view class="summary-value">¥{{budget.leftText}}</view>
        </view>
      </view>
      <view class="budget-track">
        <view class="budget-progress" style="width: {{budget.percent}}%;"></view>
      </view>
      <view class="hero-note">本月预算 ¥{{budget.totalText}}，已使用 {{budget.percent}}%</view>
    </view>
  </view>

  <view class="section card">
    <view class="title">账本总览</view>
    <view class="period-grid">
      <view class="period-item" wx:for="{{periodStats}}" wx:key="label">
        <view class="period-title">{{item.label}}</view>
        <view class="period-balance">¥{{item.balanceText}}</view>
        <view class="period-line">
          <text>收 ¥{{item.incomeText}}</text>
          <text>支 ¥{{item.expenseText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-add" bindtap="goAdd">
    <image class="quick-logo" src="/assets/app-icon-dollar-small.png" mode="aspectFill"></image>
    <view>
      <view class="quick-title">记一笔</view>
      <view class="quick-subtitle">记录今天的收入或支出</view>
    </view>
  </view>

  <view class="section card">
    <view class="between">
      <view class="title">最近记录</view>
      <view class="link" bindtap="goRecords">全部</view>
    </view>
    <block wx:if="{{recentRecords.length}}">
      <view class="record" wx:for="{{recentRecords}}" wx:key="id">
        <view>
          <view class="record-title">{{item.category}}</view>
          <view class="subtitle">{{item.date}} {{item.note}}</view>
          <view class="record-time">提交 {{item.createdAtText}}</view>
        </view>
        <view class="{{item.type === 'income' ? 'amount-income' : 'amount-expense'}}">
          {{item.type === 'income' ? '+' : '-'}}¥{{item.amountText}}
        </view>
      </view>
    </block>
    <view wx:else class="empty">还没有账目，先记一笔</view>
  </view>

  <view class="section card">
    <view class="title">收入排行</view>
    <block wx:if="{{incomeRanking.length}}">
      <view class="category-line" wx:for="{{incomeRanking}}" wx:key="name">
        <view class="between">
          <view>{{item.name}}</view>
          <view>¥{{item.amountText}}</view>
        </view>
        <view class="bar">
          <view class="bar-inner" style="width: {{item.percent}}%;"></view>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无收入统计</view>
  </view>
</view>
