.filter-card {
  display: grid;
  gap: 22rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 64rpx;
}

.filter-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.tab {
  height: 64rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #6b7280;
  line-height: 64rpx;
  text-align: center;
}

.tab.active {
  background: #b7791f;
  color: #fff;
  font-weight: 700;
}

.total {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.record {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.record:last-child {
  border-bottom: 0;
}

.record-main {
  display: flex;
  align-items: center;
  min-width: 0;
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  border-radius: 36rpx;
  background: #fff1d6;
  color: #b7791f;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
  text-align: center;
}

.record-icon.income {
  background: #fef3c7;
  color: #92400e;
}

.record-title {
  font-weight: 700;
}

.record-side {
  text-align: right;
}

.record-time,
.detail-tip {
  margin-top: 6rpx;
  color: #9a8053;
  font-size: 22rpx;
}

.delete {
  margin-top: 8rpx;
  color: #9b1c1c;
  font-size: 24rpx;
}
