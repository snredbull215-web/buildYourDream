<view class="page">
  <view class="card">
    <picker mode="date" fields="month" value="{{monthKey}}" bindchange="onMonthChange">
      <view class="between">
        <view>
          <view class="muted">统计月份</view>
          <view class="month">{{monthKey}}</view>
        </view>
        <view class="muted">切换</view>
      </view>
    </picker>

    <view class="metrics">
      <view>
        <view class="muted">收入</view>
        <view class="metric amount-income">¥{{summary.incomeText}}</view>
      </view>
      <view>
        <view class="muted">支出</view>
        <view class="metric amount-expense">¥{{summary.expenseText}}</view>
      </view>
      <view>
        <view class="muted">结余</view>
        <view class="metric">¥{{summary.balanceText}}</view>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="title">预算进度</view>
    <view class="budget-row">
      <view class="budget-ring">
        <view class="budget-percent">{{budget.percent}}%</view>
      </view>
      <view class="budget-copy">
        <view>预算 ¥{{budget.totalText}}</view>
        <view class="subtitle">已花 ¥{{summary.expenseText}}，剩余 ¥{{budget.leftText}}</view>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="title">支出分类</view>
    <block wx:if="{{expenseRows.length}}">
      <view class="stat-row" wx:for="{{expenseRows}}" wx:key="name">
        <view class="between">
          <view>{{item.name}}</view>
          <view>¥{{item.amountText}}</view>
        </view>
        <view class="bar">
          <view class="bar-inner" style="width: {{item.percent}}%;"></view>
        </view>
      </view>
    </block>
    <view wx:else class="empty">本月还没有支出</view>
  </view>

  <view class="section card">
    <view class="title">收入分类</view>
    <block wx:if="{{incomeRows.length}}">
      <view class="stat-row" wx:for="{{incomeRows}}" wx:key="name">
        <view class="between">
          <view>{{item.name}}</view>
          <view>¥{{item.amountText}}</view>
        </view>
        <view class="bar income">
          <view class="bar-inner income" style="width: {{item.percent}}%;"></view>
        </view>
      </view>
    </block>
    <view wx:else class="empty">本月还没有收入</view>
  </view>
</view>
