<view class="page">
  <view class="card">
    <view class="title">预算设置</view>
    <view class="field">
      <view class="label">月度预算</view>
      <view class="budget-input">
        <text>¥</text>
        <input type="digit" value="{{monthlyBudget}}" bindinput="onBudgetInput" />
      </view>
    </view>
    <button class="primary-button" bindtap="saveBudget">保存预算</button>
  </view>

  <view class="section card">
    <view class="title">数据工具</view>
    <button class="secondary-button action" bindtap="copyExportData">复制备份 JSON</button>
    <button class="secondary-button action" bindtap="loadDemoData">导入演示数据</button>
    <button class="danger-button action" bindtap="confirmClear">清空所有账目</button>
  </view>

  <view class="section card">
    <view class="title">功能范围</view>
    <view class="scope-row">
      <text>本地记账</text>
      <text class="muted">已支持</text>
    </view>
    <view class="scope-row">
      <text>月度统计</text>
      <text class="muted">已支持</text>
    </view>
    <view class="scope-row">
      <text>云同步</text>
      <text class="muted">后续接入云开发</text>
    </view>
  </view>
</view>
