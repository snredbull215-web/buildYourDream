<view class="page">
  <view class="add-brand">
    <image class="add-logo" src="/assets/app-icon-dollar-small.png" mode="aspectFill"></image>
    <view>
      <view class="add-brand-title">记一笔</view>
      <view class="add-brand-subtitle">每一笔收支都清清楚楚</view>
    </view>
  </view>

  <view class="card">
    <view class="type-switch">
      <view class="type-option {{form.type === 'expense' ? 'active expense' : ''}}" data-type="expense" bindtap="changeType">支出</view>
      <view class="type-option {{form.type === 'income' ? 'active income' : ''}}" data-type="income" bindtap="changeType">收入</view>
    </view>

    <view class="field amount-field">
      <view class="label">金额</view>
      <view class="amount-input-wrap">
        <text>¥</text>
        <input class="amount-input" type="digit" placeholder="0.00" value="{{form.amount}}" bindinput="onAmountInput" />
      </view>
    </view>

    <view class="field">
      <view class="label">分类</view>
      <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-value">{{form.category}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">日期</view>
      <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
        <view class="picker-value">{{form.date}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="label">备注</view>
      <input class="note-input" maxlength="30" placeholder="可选，例如午餐、房租" value="{{form.note}}" bindinput="onNoteInput" />
    </view>
  </view>

  <button class="primary-button submit" bindtap="saveRecord">保存</button>
</view>
