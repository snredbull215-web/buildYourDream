.add-brand {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid #e1c88d;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #fff8e6, #f4d27d);
}

.add-logo {
  width: 86rpx;
  height: 86rpx;
  margin-right: 20rpx;
  border-radius: 20rpx;
}

.add-brand-title {
  color: #4a2b08;
  font-size: 34rpx;
  font-weight: 900;
}

.add-brand-subtitle {
  margin-top: 6rpx;
  color: #8a5a13;
  font-size: 24rpx;
}

.type-switch {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 8rpx;
  border-radius: 8rpx;
  background: #fff4da;
}

.type-option {
  height: 74rpx;
  border-radius: 8rpx;
  color: #6b7280;
  font-weight: 700;
  line-height: 74rpx;
  text-align: center;
}

.type-option.active {
  background: #fff;
  color: #172033;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

.type-option.active.expense {
  color: #b91c1c;
}

.type-option.active.income {
  color: #8a5a13;
}

.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1e4ce;
}

.field:last-child {
  border-bottom: 0;
}

.label {
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 14rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: center;
  font-size: 54rpx;
  font-weight: 800;
}

.amount-input {
  flex: 1;
  height: 82rpx;
  margin-left: 16rpx;
  font-size: 54rpx;
  font-weight: 800;
}

.picker-value,
.note-input {
  min-height: 56rpx;
  font-size: 32rpx;
  line-height: 56rpx;
}

.submit {
  margin-top: 32rpx;
}
